{
  "manifest_version": 3,
  "name": "MIC Course Video Link Downloader",
  "version": "1.0.0",
  "description": "Detects Made-in-China training course Tencent VOD videos and adds MP4/m3u8 download controls.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://service.made-in-china.com/*",
    "https://playvideo.qcloud.com/*",
    "http://*.vod2.myqcloud.com/*",
    "https://*.vod2.myqcloud.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MIC video links",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
